<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <PackageId>PromeRotation.SDK.API12</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>MilkVio</Authors>
    <Company>PromeRotation</Company>
    <Product>PromeRotation.SDK.API12</Product>
    <Description>PromeRotation API12 编译引用包，用于在没有本地繁中服卫月开发环境的情况下编译 PromeRotation ACR 或扩展。</Description>
    <PackageTags>ffxiv;dalamud;api12;promerotation;sdk;net9</PackageTags>
    <PackageProjectUrl>https://github.com/PromeRotation/PromeRotation-SDK</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PromeRotation/PromeRotation-SDK.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>artifacts</PackageOutputPath>
    <NoWarn>$(NoWarn);NU5128;NU5131</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="..\licenses\*" Pack="true" PackagePath="licenses/" />
    <None Include="refs\*.dll" Pack="true" PackagePath="ref/net9.0-windows7.0/" />
  </ItemGroup>
</Project>
